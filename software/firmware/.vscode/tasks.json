{
    "version": "2.0.0",
    // Applies to every task below, the Pico extension's included: puts the SDK
    // toolchain, cmake, ninja and picotool on PATH. Cannot be done from this
    // folder's settings.json instead - terminal.integrated.env is window-scoped,
    // so a folder settings.json is ignored under a multi-root workspace.
    //
    // The "firmware: *" tasks are hand-written. The rest are generated by the
    // Pico extension and will be clobbered if it ever regenerates this file;
    // if that happens, restore from git.
    "options": {
        "cwd": "${workspaceFolder}",
        "env": {
            "PICO_SDK_PATH": "${userHome}/.pico-sdk/sdk/2.2.0",
            "PICO_TOOLCHAIN_PATH": "${userHome}/.pico-sdk/toolchain/14_2_Rel1",
            "PATH": "${userHome}/.pico-sdk/toolchain/14_2_Rel1/bin:${userHome}/.pico-sdk/picotool/2.2.0-a4/picotool:${userHome}/.pico-sdk/cmake/v3.31.5/bin:${userHome}/.pico-sdk/ninja/v1.12.1:${env:PATH}"
        }
    },
    "tasks": [
        {
            "label": "firmware: build",
            "detail": "Incremental build into firmware/build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "firmware: configure",
            "detail": "Fresh CMake configure of firmware/build (does not erase it)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build",
                "-G", "Ninja",
                "-DPICO_SDK_PATH=${userHome}/.pico-sdk/sdk/2.2.0",
                "-DPICO_TOOLCHAIN_PATH=${userHome}/.pico-sdk/toolchain/14_2_Rel1",
                "-DPICO_BOARD=pico2"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "firmware: clean rebuild",
            "detail": "Delete firmware/build, reconfigure, build",
            "type": "shell",
            // One shell line, so a half-deleted build dir can never be handed to
            // the configure step.
            "command": "rm -rf build && cmake -S . -B build -G Ninja -DPICO_SDK_PATH=\"${userHome}/.pico-sdk/sdk/2.2.0\" -DPICO_TOOLCHAIN_PATH=\"${userHome}/.pico-sdk/toolchain/14_2_Rel1\" -DPICO_BOARD=pico2 && cmake --build build",
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "firmware: size",
            "detail": "Flash/RAM footprint of the current ELF",
            "type": "shell",
            "command": "arm-none-eabi-size",
            "args": ["build/midi_ctrl.elf"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "firmware: deploy",
            "detail": "Build, then load the UF2 over USB and run it",
            "type": "shell",
            // picotool -f reboots a running board into BOOTSEL itself, so this
            // works without touching the button as long as USB is enumerated.
            // Plain paths, no ${command:raspberry-pi-pico.*}: still works with
            // the Pico extension disabled.
            "command": "picotool",
            "args": ["load", "build/midi_ctrl.uf2", "-fx"],
            "dependsOn": "firmware: build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "Compile Project",
            "type": "process",
            "isBuildCommand": true,
            "command": "${userHome}/.pico-sdk/ninja/v1.12.1/ninja",
            "args": ["-C", "${workspaceFolder}/build"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc",
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1/ninja.exe"
            }
        },
        {
            "label": "Run Project",
            "type": "process",
            "command": "${env:HOME}/.pico-sdk/picotool/2.2.0-a4/picotool/picotool",
            "args": [
                "load",
                "${command:raspberry-pi-pico.launchTargetPath}",
                "-fx"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/picotool/2.2.0-a4/picotool/picotool.exe"
            }
        },
        {
            "label": "Flash",
            "type": "process",
            "command": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            "args": [
                "-s",
                "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/${command:raspberry-pi-pico.getTarget}.cfg",
                "-c",
                "adapter speed 5000; program \"${command:raspberry-pi-pico.launchTargetPath}\" verify reset exit"
            ],
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            }
        },
        {
            "label": "Rescue Reset",
            "type": "process",
            "command": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            "args": [
                "-s",
                "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/${command:raspberry-pi-pico.getChip}-rescue.cfg",
                "-c",
                "adapter speed 5000; reset halt; exit"
            ],
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            }
        },
        {
            "label": "RISC-V Reset (RP2350)",
            "type": "process",
            "command": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            "args": [
                "-s",
                "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
                "-c",
                "set USE_CORE { rv0 rv1 cm0 cm1 }",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/rp2350.cfg",
                "-c",
                "adapter speed 5000; init;",
                "-c",
                "write_memory 0x40120158 8 { 0x3 }; echo [format \"Info : ARCHSEL 0x%02x\" [read_memory 0x40120158 8 1]];",
                "-c",
                "reset halt; targets rp2350.rv0; echo [format \"Info : ARCHSEL_STATUS 0x%02x\" [read_memory 0x4012015C 8 1]]; exit"
            ],
            "problemMatcher": [],
            "windows": {
                "command": "${env:USERPROFILE}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
            }
        }
    ]
}
