# ==========================================
# KiCad Version Control Gitignore Template
# Supports KiCad v6, v7, v8, v9, and v10
# ==========================================

# Default fab toolkit stuff
production
fabrication-toolkit-options.json

# Temporary and auto-save files
*-bak
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
*-backups
*.kicad_pcb.lck
*.kicad_sch.lck

# KiCad internal incremental backup folder (v9+)
.history/

# Transitory footprint and symbol caches
fp-info-cache
*.html
*.xml
*.csv

# Local project preferences (window positions, visible layers)
# Exclude this to prevent merge conflicts when multiple people edit the files
*.kicad_prl

